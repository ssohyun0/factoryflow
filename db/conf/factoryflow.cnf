# ------------------------------------------------------------
# FactoryFlow MySQL 설정
# 한글(품목명, 출하처)과 이모지까지 안전하게 저장하도록 utf8mb4를 기본값으로 쓰고,
# NOW() 등 시각 함수가 한국 시간을 돌려주도록 서버 시간대를 +09:00으로 둔다.
# ------------------------------------------------------------
[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
default-time-zone    = '+09:00'

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
